{
  "name": "gestion-proceso-desarrollo",
  "version": "1.0.0",
  "description": "Sistema CRUD Users y Productos con CI/CD, Playwright y OpenObserve",
  "main": "api.js",
  "scripts": {
    "start": "node api.js",
    "test:e2e": "playwright test",
    "test": "npx playwright test",
    "test:coverage": "npx c8 --include=api.js --include=database.js --reporter=text --reporter=html --reporter=lcov npx playwright test"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "c8": "^12.0.0"
  }
}
